{
  "name": "vsc-smith",
  "displayName": "VSCodeSmith",
  "description": "雑多な拡張機能集",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "VSCodeSmith",
      "properties": {
        "vsc-smith.fileSize.enabled": {
          "type": "boolean",
          "default": true,
          "description": "file-size: ファイルサイズ表示機能を有効にする"
        },
        "vsc-smith.fileSize.statusBar": {
          "type": "boolean",
          "default": true,
          "description": "file-size: アクティブなファイルのサイズをステータスバーに表示する"
        },
        "vsc-smith.fileSize.statusBarAlignment": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ],
          "default": "left",
          "description": "file-size: ステータスバー上の表示位置 (右側はテキストファイルで行/列・エンコーディングなどの項目と並ぶため、既定は左)"
        },
        "vsc-smith.fileSize.explorerTooltip": {
          "type": "boolean",
          "default": true,
          "description": "file-size: エクスプローラーでファイルにホバーした時のツールチップにサイズを表示する"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.70.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/heppocogne/vsc-smith.git"
  }
}