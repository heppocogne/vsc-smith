{
  "name": "vsc-smith",
  "displayName": "VSCode Smith",
  "description": "雑多な拡張機能集",
  "publisher": "heppocogne",
  "version": "0.0.4",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:vsc-smith.copyRelativePath.slash",
    "onCommand:vsc-smith.copyRelativePath.backslash",
    "onCommand:vsc-smith.markdown.onEnter",
    "onCommand:vsc-smith.markdown.onTab",
    "onCommand:vsc-smith.markdown.onShiftTab",
    "onCommand:vsc-smith.markdown.pasteAsTable",
    "onCommand:vsc-smith.markdown.openFullPreview"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": [
      {
        "title": "File Size",
        "properties": {
          "vsc-smith.fileSize.enabled": {
            "type": "boolean",
            "default": true,
            "description": "file-size: ファイルサイズ表示機能を有効にする"
          },
          "vsc-smith.fileSize.statusBar": {
            "type": "boolean",
            "default": true,
            "description": "file-size: アクティブなファイルのサイズをステータスバーに表示する"
          },
          "vsc-smith.fileSize.statusBarAlignment": {
            "type": "string",
            "enum": [
              "left",
              "right"
            ],
            "default": "left",
            "description": "file-size: ステータスバー上の表示位置 (右側はテキストファイルで行/列・エンコーディングなどの項目と並ぶため、既定は左)"
          },
          "vsc-smith.fileSize.explorerTooltip": {
            "type": "boolean",
            "default": true,
            "description": "file-size: エクスプローラーでファイルにホバーした時のツールチップにサイズを表示する"
          }
        }
      },
      {
        "title": "Copy Path",
        "properties": {
          "vsc-smith.copyPath.enabled": {
            "type": "boolean",
            "default": true,
            "description": "copy-path: 相対パスを、標準の \"Copy Relative Path\" (explorer.copyRelativePathSeparator) とは逆の区切り文字でコピーするコマンドを有効にする (標準が / なら \\ 区切り、\\ なら / 区切り)"
          }
        }
      },
      {
        "title": "Markdown",
        "properties": {
          "vsc-smith.markdown.enabled": {
            "type": "boolean",
            "default": true,
            "description": "markdown: Enter で箇条書き・番号付きリスト・タスクリスト・引用を継続し、Tab / Shift+Tab でリスト項目をインデント/アウトデントする"
          },
          "vsc-smith.markdown.pasteTable.enabled": {
            "type": "boolean",
            "default": true,
            "description": "markdown: スプレッドシートからコピーしたタブ区切りテキストを貼り付けたとき、Markdown のテーブルとして貼り付けるか、そのまま (タブ区切り) 貼り付けるかを、貼り付け後に表示される選択肢 (VS Code 1.87 以降) から切り替えられるようにする。それ以前の VS Code では「Paste as Markdown Table」コマンドでテーブルとして貼り付ける"
          },
          "vsc-smith.markdown.pasteTable.default": {
            "type": "string",
            "enum": [
              "table",
              "text"
            ],
            "default": "text",
            "description": "markdown: タブ区切りテキストを貼り付けたとき最初に挿入する形式 (table: テーブルの書式, text: そのまま)。貼り付け直後の選択肢 (Ctrl+. など) でもう一方に切り替えられる"
          },
          "vsc-smith.markdown.yieldToMarkdownAllInOne": {
            "type": "boolean",
            "default": true,
            "description": "markdown: Markdown All in One が有効なときは、同等の機能を持つそちらに Enter / Tab / Shift+Tab を譲る (Markdown All in One 側でリスト継続を無効にしている場合は false にする)"
          }
        }
      },
      {
        "title": "GFM",
        "properties": {
          "vsc-smith.gfm.enabled": {
            "type": "boolean",
            "default": true,
            "description": "gfm: Markdown プレビューでタスクリストのチェックボックス、アラート (> [!NOTE] など)、脚注 ([^1]) を表示する"
          }
        }
      },
      {
        "title": "Mermaid",
        "properties": {
          "vsc-smith.mermaid.enabled": {
            "type": "boolean",
            "default": true,
            "description": "mermaid: Markdown プレビューで mermaid のコードブロックを図として表示する"
          },
          "vsc-smith.mermaid.yieldToOtherExtensions": {
            "type": "boolean",
            "default": true,
            "description": "mermaid: VS Code 標準の Mermaid 表示 (1.121 以降の Mermaid Markdown Features) か Markdown Preview Mermaid Support が有効なときは、そちらに表示を譲る"
          }
        }
      },
      {
        "title": "Copy Button",
        "properties": {
          "vsc-smith.copyButton.enabled": {
            "type": "boolean",
            "default": true,
            "description": "copyButton: Markdown プレビューのコードブロックにコピーボタンを表示する"
          },
          "vsc-smith.copyButton.position": {
            "type": "string",
            "enum": [
              "top-right",
              "bottom-right"
            ],
            "enumDescriptions": [
              "右上",
              "右下"
            ],
            "default": "top-right",
            "description": "copyButton: コピーボタンの位置"
          }
        }
      }
    ],
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./media/gfm.css",
      "./media/mermaid.css",
      "./media/copyButton.css"
    ],
    "markdown.previewScripts": [
      "./media/mermaid.js",
      "./media/copyButton.js"
    ],
    "commands": [
      {
        "command": "vsc-smith.copyRelativePath.slash",
        "title": "Copy Relative Path (/)",
        "category": "VSCodeSmith"
      },
      {
        "command": "vsc-smith.copyRelativePath.backslash",
        "title": "Copy Relative Path (\\)",
        "category": "VSCodeSmith"
      },
      {
        "command": "vsc-smith.markdown.pasteAsTable",
        "title": "Paste as Markdown Table",
        "category": "VSCodeSmith"
      },
      {
        "command": "vsc-smith.markdown.openFullPreview",
        "title": "Open Full Preview",
        "category": "VSCodeSmith",
        "icon": "$(screen-full)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "vsc-smith.markdown.openFullPreview",
          "when": "config.vsc-smith.markdown.enabled && editorLangId == markdown"
        },
        {
          "command": "vsc-smith.markdown.pasteAsTable",
          "when": "config.vsc-smith.markdown.enabled && config.vsc-smith.markdown.pasteTable.enabled && editorLangId == markdown && !editorReadonly"
        },
        {
          "command": "vsc-smith.copyRelativePath.slash",
          "when": "config.vsc-smith.copyPath.enabled && ((config.explorer.copyRelativePathSeparator == auto && isWindows) || (config.explorer.copyRelativePathSeparator != auto && config.explorer.copyRelativePathSeparator != '/'))"
        },
        {
          "command": "vsc-smith.copyRelativePath.backslash",
          "when": "config.vsc-smith.copyPath.enabled && ((config.explorer.copyRelativePathSeparator == auto && !isWindows) || config.explorer.copyRelativePathSeparator == '/')"
        }
      ],
      "explorer/context": [
        {
          "command": "vsc-smith.copyRelativePath.slash",
          "when": "config.vsc-smith.copyPath.enabled && ((config.explorer.copyRelativePathSeparator == auto && isWindows) || (config.explorer.copyRelativePathSeparator != auto && config.explorer.copyRelativePathSeparator != '/'))",
          "group": "6_copypath",
          "order": 60
        },
        {
          "command": "vsc-smith.copyRelativePath.backslash",
          "when": "config.vsc-smith.copyPath.enabled && ((config.explorer.copyRelativePathSeparator == auto && !isWindows) || config.explorer.copyRelativePathSeparator == '/')",
          "group": "6_copypath",
          "order": 60
        }
      ],
      "editor/title": [
        {
          "command": "vsc-smith.markdown.openFullPreview",
          "when": "config.vsc-smith.markdown.enabled && editorLangId == markdown",
          "group": "navigation@-99"
        }
      ],
      "editor/title/context": [
        {
          "command": "vsc-smith.copyRelativePath.slash",
          "when": "config.vsc-smith.copyPath.enabled && ((config.explorer.copyRelativePathSeparator == auto && isWindows) || (config.explorer.copyRelativePathSeparator != auto && config.explorer.copyRelativePathSeparator != '/')) && resourceScheme != untitled",
          "group": "1_cutcopypaste",
          "order": 60
        },
        {
          "command": "vsc-smith.copyRelativePath.backslash",
          "when": "config.vsc-smith.copyPath.enabled && ((config.explorer.copyRelativePathSeparator == auto && !isWindows) || config.explorer.copyRelativePathSeparator == '/') && resourceScheme != untitled",
          "group": "1_cutcopypaste",
          "order": 60
        }
      ]
    },
    "keybindings": [
      {
        "key": "enter",
        "command": "vsc-smith.markdown.onEnter",
        "when": "editorTextFocus && !editorReadonly && editorLangId == markdown && config.vsc-smith.markdown.enabled && !editorHasSelection && !editorHasMultipleSelections && !suggestWidgetVisible && !inSnippetMode && !vsc-smith.markdown.yieldToMaio"
      },
      {
        "key": "tab",
        "command": "vsc-smith.markdown.onTab",
        "when": "editorTextFocus && !editorReadonly && editorLangId == markdown && config.vsc-smith.markdown.enabled && !editorHasSelection && !editorHasMultipleSelections && !suggestWidgetVisible && !inlineSuggestionVisible && !inSnippetMode && !vsc-smith.markdown.yieldToMaio && !editorTabMovesFocus && !inlineEditIsVisible"
      },
      {
        "key": "shift+tab",
        "command": "vsc-smith.markdown.onShiftTab",
        "when": "editorTextFocus && !editorReadonly && editorLangId == markdown && config.vsc-smith.markdown.enabled && !editorHasSelection && !editorHasMultipleSelections && !suggestWidgetVisible && !inlineSuggestionVisible && !inSnippetMode && !vsc-smith.markdown.yieldToMaio && !editorTabMovesFocus"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.70.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "markdown-it": "^14.3.2",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/heppocogne/vsc-smith.git"
  },
  "dependencies": {
    "mermaid": "^12.1.0"
  }
}